{
  "tables": [
    {
      "tableName": "UserLearningProfile",
      "description": "Stores user learning preferences, goals, and skill levels",
      "keySchema": {
        "partitionKey": { "name": "userId", "type": "S" }
      },
      "attributes": {
        "userId": "Cognito user sub ID",
        "displayName": "User display name",
        "preferredLanguage": "Primary language code (hi, en, ta, etc.)",
        "spokenLanguages": "List of languages user speaks",
        "learningGoals": "List of learning goal strings",
        "skillLevel": "beginner | intermediate | advanced",
        "interests": "List of category interests",
        "location": "{ state, district, pincode }",
        "trustScore": "0-100 trust score based on DigiLocker verification",
        "isVerified": "Boolean – DigiLocker verified",
        "verificationDetails": "{ provider, verifiedAt, documentTypes }",
        "totalCoursesCompleted": "Count of completed courses",
        "totalTimeSpentMins": "Total learning time in minutes",
        "lastActiveAt": "ISO timestamp of last activity",
        "createdAt": "ISO timestamp",
        "updatedAt": "ISO timestamp"
      },
      "gsi": [
        {
          "indexName": "ByLocation",
          "partitionKey": "location.state",
          "sortKey": "location.district",
          "purpose": "Find nearby users for peer grouping"
        },
        {
          "indexName": "BySkillLevel",
          "partitionKey": "skillLevel",
          "sortKey": "lastActiveAt",
          "purpose": "Group users by skill level"
        }
      ]
    },
    {
      "tableName": "PeerGroups",
      "description": "AI-created peer learning groups",
      "keySchema": {
        "partitionKey": { "name": "groupId", "type": "S" }
      },
      "attributes": {
        "groupId": "UUID of the group",
        "name": "Auto-generated or user-set group name",
        "description": "Group description / shared goals",
        "goals": "List of shared learning goals",
        "category": "Primary category (agriculture, digital-literacy, etc.)",
        "language": "Primary group language",
        "location": "{ state, district }",
        "members": "List of { userId, displayName, role, joinedAt }",
        "maxMembers": "Max allowed members (default 20)",
        "activityScore": "0-100 group activity score",
        "clusteringReason": "AI explanation of why members are grouped",
        "isActive": "Boolean",
        "createdAt": "ISO timestamp",
        "updatedAt": "ISO timestamp"
      },
      "gsi": [
        {
          "indexName": "ByCategory",
          "partitionKey": "category",
          "sortKey": "activityScore",
          "purpose": "Find active groups by category"
        },
        {
          "indexName": "ByLocation",
          "partitionKey": "location.state",
          "sortKey": "createdAt",
          "purpose": "Find regional peer groups"
        }
      ]
    },
    {
      "tableName": "LearningRecommendations",
      "description": "AI-generated personalized learning recommendations",
      "keySchema": {
        "partitionKey": { "name": "userId", "type": "S" },
        "sortKey": { "name": "generatedAt", "type": "S" }
      },
      "attributes": {
        "userId": "Cognito user sub ID",
        "generatedAt": "ISO timestamp",
        "recommendedCourses": "List of { courseId, title, reason, priority }",
        "recommendedGroups": "List of { groupId, name, matchReason }",
        "nextSteps": "List of suggested next actions",
        "reasoning": "AI explanation for recommendations",
        "modelVersion": "Bedrock model version used",
        "isActedUpon": "Boolean – if user acted on any recommendation",
        "expiresAt": "ISO timestamp – TTL"
      }
    },
    {
      "tableName": "ContentInteractions",
      "description": "Tracks every user interaction with learning content",
      "keySchema": {
        "partitionKey": { "name": "userId", "type": "S" },
        "sortKey": { "name": "interactionId", "type": "S" }
      },
      "attributes": {
        "userId": "Cognito user sub ID",
        "interactionId": "UUID",
        "contentType": "course | module | govt-course | peer-discussion",
        "contentId": "ID of the content item",
        "interactionType": "view | start | complete | rate | share | bookmark",
        "durationSecs": "Time spent in seconds",
        "rating": "1-5 star rating (optional)",
        "language": "Language content was consumed in",
        "voiceUsed": "Boolean – if voice interface was used",
        "timestamp": "ISO timestamp"
      },
      "gsi": [
        {
          "indexName": "ByContent",
          "partitionKey": "contentId",
          "sortKey": "timestamp",
          "purpose": "Aggregate interactions for a content item"
        }
      ]
    },
    {
      "tableName": "FarmPracticeLogs",
      "description": "Stores farmer-entered precision agriculture practice logs for advisory analysis",
      "keySchema": {
        "partitionKey": { "name": "userId", "type": "S" },
        "sortKey": { "name": "loggedAt", "type": "S" }
      },
      "attributes": {
        "userId": "Cognito user sub ID",
        "loggedAt": "ISO timestamp of the practice event",
        "practiceId": "UUID of the log entry",
        "crop_type": "Crop tied to the practice",
        "field_id": "Optional field identifier",
        "practice_type": "Normalized practice type",
        "quantity": "Numeric amount logged",
        "unit": "Unit for quantity",
        "notes": "Farmer note or transcription",
        "metadata": "Additional structured context such as source or device state"
      },
      "gsi": [
        {
          "indexName": "ByCropType",
          "partitionKey": "crop_type",
          "sortKey": "loggedAt",
          "purpose": "Analyze recent practice patterns by crop"
        }
      ]
    },
    {
      "tableName": "EconomicProfiles",
      "description": "Stores farmer financial and farm profile details used for scheme and savings guidance",
      "keySchema": {
        "partitionKey": { "name": "userId", "type": "S" }
      },
      "attributes": {
        "userId": "Cognito user sub ID",
        "full_name": "Farmer name",
        "state": "State name",
        "district": "District name",
        "primary_language": "Preferred language code",
        "land_size_acres": "Total farm land in acres",
        "crop_types": "Primary crops",
        "annual_income_inr": "Approximate annual income",
        "expected_harvest_income_inr": "Expected harvest income",
        "seasonal_expenses": "Expected seasonal farm expenses",
        "harvest_months": "Likely harvest months",
        "has_bank_account": "Bank account readiness",
        "has_kcc": "Existing Kisan Credit Card status",
        "digilocker_verified": "KYC readiness through DigiLocker",
        "insurance_provider": "Active insurance provider if any",
        "createdAt": "ISO timestamp",
        "updatedAt": "ISO timestamp"
      }
    },
    {
      "tableName": "InsuranceClaims",
      "description": "Stores draft and submitted agriculture insurance claim records",
      "keySchema": {
        "partitionKey": { "name": "userId", "type": "S" },
        "sortKey": { "name": "claimId", "type": "S" }
      },
      "attributes": {
        "userId": "Cognito user sub ID",
        "claimId": "UUID of the claim",
        "scheme_id": "Insurance scheme identifier",
        "crop_type": "Affected crop",
        "loss_date": "Loss incident date",
        "area_affected_acres": "Affected area",
        "location": "Structured location object",
        "damage_signals": "Damage evidence list",
        "notes": "Voice/text notes from farmer",
        "digilocker_consent": "Consent flag for document retrieval",
        "status": "Claim processing status",
        "damage_assessment": "System-generated damage interpretation",
        "createdAt": "ISO timestamp"
      }
    },
    {
      "tableName": "FinancialNudges",
      "description": "Stores proactive seasonal financial planning nudges",
      "keySchema": {
        "partitionKey": { "name": "userId", "type": "S" },
        "sortKey": { "name": "generatedAt", "type": "S" }
      },
      "attributes": {
        "userId": "Cognito user sub ID",
        "generatedAt": "ISO timestamp",
        "season": "Seasonal farming phase",
        "channel": "push | sms | voice",
        "message": "Localized nudge text",
        "related_crop_types": "Crops referenced by the nudge"
      }
    },
    {
      "tableName": "Users",
      "description": "Registered user accounts with phone-based auth and DigiLocker verification",
      "keySchema": {
        "partitionKey": { "name": "userId", "type": "S" }
      },
      "attributes": {
        "userId": "UUID – primary user identifier",
        "phone": "Mobile phone number (unique)",
        "hashedPin": "bcrypt-hashed 4-6 digit PIN",
        "name": "User display name",
        "preferredLanguage": "Language code (hi, en, ta, etc.)",
        "state": "Indian state",
        "district": "District name",
        "registeredVia": "app | voice | web",
        "isVerified": "Boolean – DigiLocker verified",
        "digilockerData": "{ aadhaarName, documentTypes, verifiedAt, provider }",
        "profileComplete": "Boolean – all required fields filled",
        "onboardingDone": "Boolean – onboarding flow completed",
        "totalSessions": "Number of app sessions",
        "totalVoiceInteractions": "Number of voice interactions",
        "lastActiveAt": "ISO timestamp of last activity",
        "createdAt": "ISO timestamp",
        "updatedAt": "ISO timestamp"
      },
      "gsi": [
        {
          "indexName": "ByPhone",
          "partitionKey": "phone",
          "purpose": "Look up user by phone number for login"
        }
      ]
    },
    {
      "tableName": "PersonalizedRecommendations",
      "description": "User feedback and cached personalized recommendations for continuous learning",
      "keySchema": {
        "partitionKey": { "name": "userId", "type": "S" },
        "sortKey": { "name": "feedbackId", "type": "S" }
      },
      "attributes": {
        "userId": "User ID",
        "feedbackId": "Composite: recs#timestamp for cached recs, or userId#timestamp#uuid for feedback",
        "interactionId": "Session or recommendation ID being rated",
        "domain": "Domain category (market, crop, scheme, health, etc.)",
        "rating": "1-5 rating",
        "feedbackText": "Optional text feedback",
        "action": "followed | ignored | dismissed",
        "recommendations": "Array of recommendation objects (for cached recs)",
        "generatedAt": "ISO timestamp when recommendations were generated",
        "createdAt": "ISO timestamp",
        "ttl": "Time-to-live epoch seconds"
      }
    }
  ]
}
