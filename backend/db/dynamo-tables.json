{
  "tables": [
    {
      "tableName": "VoiceRooms",
      "description": "Voice room metadata – status, topics, creator, recording state",
      "keySchema": {
        "partitionKey": {
          "name": "roomId",
          "type": "S"
        }
      },
      "attributes": {
        "roomId": "UUID of the room",
        "title": "Room title",
        "description": "Optional description",
        "status": "active | ended",
        "isPrivate": "Boolean – requires approval to join",
        "isRecording": "Boolean – recording state",
        "maxParticipants": "Max allowed participants (default 50)",
        "topics": "List of topic tags (agriculture, health, etc.)",
        "creatorId": "User ID who created the room",
        "creatorName": "Denormalized creator name",
        "participantCount": "Current active participant count",
        "createdAt": "ISO timestamp",
        "updatedAt": "ISO timestamp",
        "endedAt": "ISO timestamp – when room ended"
      },
      "gsi": [
        {
          "indexName": "ByStatus",
          "partitionKey": "status",
          "sortKey": "createdAt",
          "purpose": "List active/ended rooms sorted by creation time"
        }
      ]
    },
    {
      "tableName": "VoiceRoomParticipants",
      "description": "Active participants in a voice room with their roles",
      "keySchema": {
        "partitionKey": {
          "name": "roomId",
          "type": "S"
        },
        "sortKey": {
          "name": "userId",
          "type": "S"
        }
      },
      "attributes": {
        "roomId": "UUID of the room",
        "userId": "User ID",
        "userName": "Denormalized user name",
        "role": "moderator | speaker | listener",
        "isMuted": "Boolean",
        "isBlocked": "Boolean – banned from room",
        "blockedBy": "User ID who banned (if blocked)",
        "joinedAt": "ISO timestamp",
        "leftAt": "ISO timestamp – null if still in room"
      }
    },
    {
      "tableName": "ChatMessages",
      "description": "In-room text chat messages",
      "keySchema": {
        "partitionKey": {
          "name": "roomId",
          "type": "S"
        },
        "sortKey": {
          "name": "messageId",
          "type": "S"
        }
      },
      "attributes": {
        "roomId": "UUID of the room",
        "messageId": "UUID with timestamp prefix for ordering (e.g. 2024-01-15T10:30:00Z#uuid)",
        "userId": "Sender user ID",
        "userName": "Denormalized sender name",
        "content": "Message text",
        "createdAt": "ISO timestamp"
      }
    },
    {
      "tableName": "WebSocketConnections",
      "description": "Active WebSocket connections for real-time signaling",
      "keySchema": {
        "partitionKey": {
          "name": "connectionId",
          "type": "S"
        }
      },
      "attributes": {
        "connectionId": "API Gateway WebSocket connection ID",
        "userId": "Authenticated user ID",
        "roomId": "Room the connection is associated with (null if not in a room)",
        "connectedAt": "ISO timestamp",
        "ttl": "Unix epoch for auto-cleanup (2 hours after connect)"
      }
    }
  ]
}