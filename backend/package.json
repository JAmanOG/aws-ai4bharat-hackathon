{
  "name": "rural-ecosystem-knowledge-backend",
  "version": "1.0.0",
  "description": "Backend for Knowledge Sharing & Learning module - Rural Ecosystem Platform",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint .",
    "local": "sam local start-api --template ../infra/template.yaml"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "@aws-sdk/client-polly": "^3.500.0",
    "@aws-sdk/client-transcribe": "^3.500.0",
    "@aws-sdk/client-translate": "^3.500.0",
    "@aws-sdk/client-bedrock-runtime": "^3.500.0",
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@aws-sdk/client-sns": "^3.500.0",
    "@aws-sdk/client-sqs": "^3.500.0",
    "pg": "^8.12.0",
    "uuid": "^9.0.0",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.56.0",
    "@types/jest": "^29.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "lambdas/**/*.js",
      "services/**/*.js",
      "utils/**/*.js"
    ]
  }
}
