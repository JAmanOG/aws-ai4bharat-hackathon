{
  "name": "rural-health-services",
  "version": "1.0.0",
  "description": "Health Services Access – Requirement 9: symptom checker, imaging, govt portals, providers, knowledge base",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "lint": "eslint .",
    "local": "sam local start-api --template ../infra/template.yaml"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "@aws-sdk/client-bedrock-runtime": "^3.500.0",
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "axios": "^1.7.0",
    "pg": "^8.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "lambdas/**/*.js",
      "utils/**/*.js"
    ]
  }
}
