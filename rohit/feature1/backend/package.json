{
  "name": "rural-open-data-service",
  "version": "1.0.0",
  "description": "Open Data & Interoperability Service – Requirement 11: data export, open standards, government integration",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "lint": "eslint .",
    "local": "sam local start-api --template ../infra/template.yaml"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "axios": "^1.7.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "lambdas/**/*.js",
      "utils/**/*.js"
    ]
  }
}
